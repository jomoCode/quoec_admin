# Copy to .env.development (local) or set these in your host's environment settings.
# NEXT_PUBLIC_* values are built into the app, so redeploy after changing them.

# This portal's own address (admin, security and resident app)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# The public marketing website (The Citadel) — used for "View on website" links and search previews
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
# Your backend. The bare host is enough, e.g. https://citadel-api.up.railway.app — /api/v1 is added automatically.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Supabase project (public, browser-safe values). Needed for sign-in and live notifications.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
